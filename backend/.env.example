# Set the Razorpay Test Mode credentials for local testing; use production
# credentials only in the deployed backend environment.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Create a webhook in the Razorpay Dashboard, choose a webhook secret, and
# configure payment.captured and payment.failed at /api/payments/webhook.
RAZORPAY_WEBHOOK_SECRET=
